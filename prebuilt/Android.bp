// 从原厂 OxygenOS 提取的 QTI 蓝牙音频 HAL
// TheMuppets 的 vendor blob 缺少此库，导致 LE Audio / A2DP 无数据泵
// 其依赖的 libbluetooth_audio_session_qti*.so 已由 vendor blob 提供，
// 故关闭 ELF 依赖校验（构建树内看不到这些运行期库）
cc_prebuilt_library_shared {
    name: "audio.bluetooth_qti.default",
    owner: "oneplus",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["vendor/lib64/hw/audio.bluetooth_qti.default.so"],
        },
    },
    installable: true,
    vendor: true,
    relative_install_path: "hw",
    compile_multilib: "64",
    check_elf_files: false,
}
